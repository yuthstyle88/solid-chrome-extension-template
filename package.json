{
    "name": "solid-chrome-extension-template",
    "displayName": "Solid Chrome Extension Template",
    "version": "0.202212.1",
    "description": "Chrome Extension boilerplate with SolidJS + Vite + ManifestV3",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/fuyutarow/solid-chrome-extension-template.git"
    },
    "scripts": {
        "dev": "vite build -w",
        "build": "vite build",
        "lint": "eslint . --fix -c .eslintrc --ext js,ts --ignore-pattern='!.*'",
        "dev:nodemon": "nodemon",
        "build:noemit": "tsc --noEmit && vite build"
    },
    "type": "module",
    "dependencies": {
        "solid-js": "^1.9.5"
    },
    "devDependencies": {
        "@crxjs/vite-plugin": "2.0.1",
        "@tailwindcss/vite": "^4.0.7",
        "@types/chrome": "0.0.203",
        "@types/node": "^20.9.0",
        "@typescript-eslint/eslint-plugin": "^7.9.0",
        "@typescript-eslint/parser": "^7.9.0",
        "autoprefixer": "^10.4.15",
        "babel-preset-solid": "^1.6.2",
        "eslint": "^8.57.0",
        "eslint-config-prettier": "^9.1.0",
        "eslint-plugin-import": "^2.29.1",
        "eslint-plugin-jsx-a11y": "^6.8.0",
        "eslint-plugin-prettier": "^5.1.0",
        "eslint-plugin-solid": "^0.10.0",
        "eslint-plugin-tailwindcss": "^3.18.0",
        "fs-extra": "^11.2.0",
        "nodemon": "^3.0.3",
        "postcss": "^8.4.38",
        "prettier": "^3.3.0",
        "sass": "^1.77.0",
        "tailwindcss": "^3.4.17",
        "ts-node": "^10.9.2",
        "typescript": "^5.7.2",
        "vite": "^6.0.0",
        "vite-plugin-solid": "^2.11.6",
        "vite-plugin-windicss": "^1.9.4"
    },
    "exports": {
        ".": "./src/index.ts"
    }
